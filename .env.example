# Neon PostgreSQL connection string
# Get this from your Neon dashboard: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin panel password — set this to anything you want
ADMIN_PASSWORD=your_secure_password_here

# Cookie secret for signing the admin session cookie
COOKIE_SECRET=a_long_random_string_at_least_32_chars
